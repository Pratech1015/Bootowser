#!/usr/bin/env bash
#
# bootowser - start the locked-down Bootowser kiosk browser.
#
# This wrapper is deliberately dumb: it turns a small config file into a
# browser command line and execs it. The actual lockdown lives in the managed
# policy file and the source patches, so editing this script cannot weaken the
# kiosk.
#
# Arguments given on the command line are appended after the flags built here,
# which lets an operator override a single switch without editing the config.
#
set -uo pipefail

readonly PREFIX="${BOOTOWSER_PREFIX:-/usr}"
readonly LIB_DIR="${PREFIX}/lib/bootowser"
readonly CONFIG="${BOOTOWSER_CONFIG:-/etc/bootowser/bootowser.conf}"
BROWSER="${BOOTOWSER_BROWSER:-${LIB_DIR}/bootowser/bootowser}"
# Gecko resolves the system-wide policy against SysConfD, which is /etc on
# Linux -- not /etc/firefox as some documentation suggests. See the
# MOZ_SYSTEM_POLICIES branch in toolkit/modules/EnterprisePoliciesParent.sys.mjs.
readonly SYSTEM_POLICY="${BOOTOWSER_SYSTEM_POLICY:-/etc/policies/policies.json}"

log() { printf 'bootowser: %s\n' "$*" >&2; }
die() { printf 'bootowser: %s\n' "$*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Config harvesting
#
# Done first, and in a re-entrant subshell, so that reading the config can
# never recurse into this block.
# ---------------------------------------------------------------------------
dump_config() {
  [ -r "${CONFIG}" ] || return 0
  local line key val
  while IFS= read -r line || [ -n "${line}" ]; do
    case "${line}" in
      ''|'#'*) continue ;;
    esac
    case "${line}" in
      *=*) ;;
      *) continue ;;
    esac
    key="${line%%=*}"
    val="${line#*=}"
    val="${val%\"}"
    val="${val#\"}"
    # Only well-formed keys are honoured; anything else is ignored rather
    # than eval'd, so a hostile config file cannot inject shell.
    case "${key}" in
      [A-Z][A-Z0-9_]*) printf '%s=%q\n' "${key}" "${val}" ;;
    esac
  done < "${CONFIG}"
}

if [ "${1:-}" = "--dump-config" ]; then
  dump_config
  exit 0
fi

if [ -r "${CONFIG}" ]; then
  # shellcheck disable=SC1090  # generated by dump_config above
  eval "$(dump_config)"
fi

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------
START_URL="${START_URL:-about:blank}"
SCREEN_SIZE="${SCREEN_SIZE:-1920x1080}"
SCREEN_DEPTH="${SCREEN_DEPTH:-24}"
SCREEN_REFRESH="${SCREEN_REFRESH:-60}"
IDLE_BLANK_MINUTES="${IDLE_BLANK_MINUTES:-10}"
IDLE_SUSPEND_MINUTES="${IDLE_SUSPEND_MINUTES:-0}"
DISABLE_GPU="${DISABLE_GPU:-no}"
DISABLE_GPU_COMPOSITING="${DISABLE_GPU_COMPOSITING:-no}"
VERBOSE="${VERBOSE:-no}"
LOG_LEVEL="${LOG_LEVEL:-1}"
LOG_TARGET="${LOG_TARGET:-journal}"
PROFILE_DIR="${PROFILE_DIR:-/var/lib/bootowser/profile}"
EXTRA_SWITCHES="${EXTRA_SWITCHES:-}"

# ---------------------------------------------------------------------------
# Browser binary
#
# Prefer the bundled, source-patched Bootowser. The fallbacks below are for
# hosts where only a distro browser exists; see the note on ALLOW_SYSTEM_BROWSER.
# ---------------------------------------------------------------------------
if [ ! -x "${BROWSER}" ]; then
  # A distro browser is NOT equivalent to the built one: it carries none of the
  # source patches, so the top-level navigation allowlist and the removal of the
  # Ctrl+O / Ctrl+L / F12 hatches are simply absent. Policy still applies, but
  # policy is not the whole lockdown. Running one is therefore opt-in.
  if [ "${ALLOW_SYSTEM_BROWSER:-0}" = 1 ]; then
    for candidate in \
      "${LIB_DIR}/bootowser/bootowser" \
      "${LIB_DIR}/firefox/bootowser" \
      "${LIB_DIR}/firefox/firefox" \
      /usr/lib/bootowser/bootowser \
      /usr/lib/firefox/firefox \
      /usr/lib64/firefox/firefox \
      /usr/lib/firefox-esr/firefox-esr \
      /usr/bin/firefox
    do
      if [ -x "${candidate}" ]; then
        BROWSER="${candidate}"
        log "ALLOW_SYSTEM_BROWSER=1: falling back to ${BROWSER}"
        log "warning: ${BROWSER} is not the patched Bootowser build; the navigation allowlist and the removed UI escape hatches are NOT active"
        break
      fi
    done
  fi
fi

[ -x "${BROWSER}" ] || die "no Bootowser binary at ${BROWSER}; pass --browser at install time, set BOOTOWSER_BROWSER, or set ALLOW_SYSTEM_BROWSER=1 to accept an unpatched browser"

# The install directory is the parent of the binary, which is where Gecko
# looks for its distribution/ subdirectory.
BROWSER_DIR="$(dirname -- "$(readlink -f -- "${BROWSER}")")"

# ---------------------------------------------------------------------------
# Policy
#
# Firefox loads managed policy from exactly one place, resolved in this order
# (EnterprisePoliciesParent.sys.mjs, JSONPoliciesProvider):
#
#   1. $SysConfD/policies/policies.json  -> /etc/policies/policies.json
#   2. $XREAppDist/policies.json         -> <install dir>/distribution/policies.json
#
# Option 2 is only consulted when option 1 does not exist, so a host policy
# silently takes precedence over ours. Refuse to start if that happens: the
# kiosk's own policy has to be the one that is actually applied.
# ---------------------------------------------------------------------------
readonly POLICY_FILE="${BROWSER_DIR}/distribution/policies.json"

# Which of the two candidate files Firefox will actually read.
if [ -e "${SYSTEM_POLICY}" ]; then
  POLICY_ACTIVE="${SYSTEM_POLICY}"
else
  POLICY_ACTIVE="${POLICY_FILE}"
fi

[ -f "${POLICY_ACTIVE}" ] \
  || die "no managed policy found (looked for ${SYSTEM_POLICY} and ${POLICY_FILE}); refusing to start unlocked"

# The marker guards against a stale or foreign policy sitting at the path that
# wins resolution. It is an extra top-level key, which Firefox ignores.
if ! grep -q '"BootowserManaged"[[:space:]]*:[[:space:]]*true' "${POLICY_ACTIVE}" 2>/dev/null; then
  die "${POLICY_ACTIVE} is not a Bootowser policy (BootowserManaged marker absent); refusing to start unlocked"
fi

log "policy ${POLICY_ACTIVE}"

# ---------------------------------------------------------------------------
# Profile
#
# A fresh profile each boot: a kiosk should not carry cookies or a stale cache
# across reboots. Point PROFILE_DIR at a tmpfs for a fully in-memory session.
# ---------------------------------------------------------------------------
mkdir -p "${PROFILE_DIR}" || die "cannot create profile directory ${PROFILE_DIR}"
chmod 0700 "${PROFILE_DIR}"

case "${START_URL}" in
  http://*|https://*|about:blank) ;;
  file://*) die "START_URL must be http(s) or about:blank, not file:// (local file access is a local read primitive)" ;;
  *) die "START_URL must start with http://, https://, or be about:blank" ;;
esac

# ---------------------------------------------------------------------------
# Display
#
# Firefox cannot paint on a bare text console, so Bootowser ships a minimal,
# window-manager-less X server. If one is already listening we reuse it, which
# is what makes Bootowser usable inside an existing desktop session.
# ---------------------------------------------------------------------------
readonly X_DISPLAY="${DISPLAY:-:0}"
readonly XSOCKET="/tmp/.X11-unix/X${X_DISPLAY#:}"

if [ ! -S "${XSOCKET}" ]; then
  log "no X server on ${X_DISPLAY}; starting the bundled one"
  "${LIB_DIR}/bootowser-xsession" &
  x_pid=$!

  waited=0
  while [ ! -S "${XSOCKET}" ]; do
    if ! kill -0 "${x_pid}" 2>/dev/null; then
      die "the X server exited during startup; see: journalctl -u bootowser -b"
    fi
    [ "${waited}" -ge 60 ] && die "timed out waiting for an X server on ${X_DISPLAY}"
    sleep 0.5
    waited=$(( waited + 1 ))
  done
  log "X server ready after $(awk "BEGIN{print ${waited}/2}")s"
fi

# ---------------------------------------------------------------------------
# Command line
#
# Firefox has a real --kiosk mode: fullscreen that cannot be exited from
# within the browser, no context menu, no URL or loading status. Everything
# else that kiosk mode does not cover is handled by the managed policy.
# ---------------------------------------------------------------------------
CMD=(
  "${BROWSER}"
  --kiosk
  "${START_URL}"
  --kiosk-monitor 1
  --profile "${PROFILE_DIR}"
  --no-remote
  --new-instance
)

# Firefox logs to stderr when MOZ_LOG is set; keep it on the journal, never on
# a terminal that no longer exists.
case "${LOG_TARGET:-journal}" in
  none) ;;
  *)    export MOZ_LOG="${MOZ_LOG:-bootowser}" ;;
esac

[ "${DISABLE_GPU}" = "yes" ] && {
  # Firefox honours LIBGL_ALWAYS_SOFTWARE for llvmpipe without needing the
  # full --disable-gpu dance that Chromium required.
  export LIBGL_ALWAYS_SOFTWARE=1
  log "forcing software rendering (LIBGL_ALWAYS_SOFTWARE)"
}

if [ -n "${EXTRA_SWITCHES}" ]; then
  while IFS= read -r extra; do
    [ -n "${extra}" ] && CMD+=("${extra}")
  done <<< "${EXTRA_SWITCHES}"
fi

CMD+=( "$@" )

# ---------------------------------------------------------------------------
# Idle power management, done at the X level where xset lives. Absent xset the
# kiosk simply never blanks, which is safe if not ideal.
# ---------------------------------------------------------------------------
if [ "${IDLE_BLANK_MINUTES}" -gt 0 ] 2>/dev/null && command -v xset >/dev/null 2>&1; then
  blank_secs=$(( IDLE_BLANK_MINUTES * 60 ))
  ( xset s "${blank_secs}" 0 "${blank_secs}" 0; \
    xset dpms 0 0 0 >/dev/null 2>&1 ) &
  log "display blanks after ${IDLE_BLANK_MINUTES}m of idle"
elif [ "${IDLE_BLANK_MINUTES}" != "0" ]; then
  log "warning: IDLE_BLANK_MINUTES is set but xset is not installed; ignoring"
fi

if [ "${IDLE_SUSPEND_MINUTES}" -gt 0 ] 2>/dev/null && command -v xset >/dev/null 2>&1; then
  ( xset dpms 0 0 "${IDLE_SUSPEND_MINUTES}" 0 ) &
  log "display suspends after ${IDLE_SUSPEND_MINUTES}m of idle"
fi

# ---------------------------------------------------------------------------
# Run
# ---------------------------------------------------------------------------
log "exec ${CMD[0]} $(printf '%q ' "${CMD[@]:1}")"
exec "${CMD[@]}"