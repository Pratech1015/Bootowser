[Unit]
Description=Bootowser kiosk browser
Documentation=https://github.com/Pratech1015/Bootowser

# The browser starts the moment the display server is up. Nothing is ordered
# against plymouth-quit-wait.service or systemd-user-sessions.service: on a
# kiosk, waiting for the boot splash or a login session is waiting for
# nothing, and it is the browser's job to paint the first frame.
#
# Install the wait-for-splash drop-in to hold the browser until Plymouth has
# released the screen instead (LUKS prompt, a theme you want to finish):
#     tools/install.sh --wait-for-splash
# The drop-in ships at runtime/lib/systemd/system/bootowser.service.d/.
After=bootowser-xserver.service
Requires=bootowser-xserver.service

# The page can call the control API (shell commands, root hooks) as soon as
# it loads, so the sidecar must already be listening. Wants= rather than
# Requires=: a host installed without the sidecar binary skips it via its
# ConditionPathExists and the browser still runs (the page's API calls just
# fail).
Wants=bootowser-control.service
After=bootowser-control.service

# The kiosk owns the console. Two things fighting over vt1 produces a flicker
# at best and a deadlock at worst.
Conflicts=getty@tty1.service

# Give up rather than loop forever on a machine that cannot render. Raise
# StartLimitBurst (or set it to 0) if you would rather it never give up.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=bootowser
Group=bootowser
Environment=DISPLAY=:0
Environment=BOOTOWSER_CONFIG=/etc/bootowser/bootowser.conf
ExecStart=/usr/lib/bootowser/bootowser

# A kiosk that shows a blank screen is a broken kiosk. Come back.
Restart=always
RestartSec=3

# The browser is expected to have painted its first frame within this window.
# A cold start on slow eMMC can take a while, so this is generous.
TimeoutStartSec=180
TimeoutStopSec=20
KillSignal=SIGTERM
KillMode=mixed

# --- Hardening -------------------------------------------------------------
# The browser runs unprivileged already; these keep a renderer exploit from
# turning into a foothold.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
# Firefox's content sandbox creates user namespaces for every content process,
# so RestrictNamespaces=true would break it. A bare list is an allow-list, so
# this permits only the namespace types the sandbox needs and denies the rest.
# Note the syntax is the bare list: a leading "yes" is a parse error.
RestrictNamespaces=mnt uts ipc pid user cgroup
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
# Firefox compiles JIT code for SpiderMonkey and WebAssembly, which needs a
# writable-then-executable heap. This cannot be turned on.
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Empty means no capabilities at all, which is the correct default here.
# Firefox has no setuid helper like Chromium's chrome_sandbox, so its user
# namespace sandbox does the work and needs no privileges from the parent.
# Do not add CAP_SYS_ADMIN to make a sandbox failure go away: that would
# disable the containment the sandbox exists to provide.
CapabilityBoundingSet=

# Firefox reads $HOME for the default profile location. The kiosk never uses
# that path (--profile is explicit) but Firefox will still create it on first
# run, and with ProtectHome=true an unwritable $HOME shows up as a failure to
# start. Point it at the state directory.
Environment=HOME=/var/lib/bootowser

# The profile is the only writable path the kiosk needs.
#
# PrivateTmp gives a private /tmp but not a private /dev/shm. Firefox needs a
# writable /dev/shm for its parent/content-process shared memory transport, and
# PrivateDevices (which would otherwise provide one) would hide the X socket
# and GPU device nodes the kiosk depends on, so /dev is left alone.
ReadWritePaths=/var/lib/bootowser
StateDirectory=bootowser
StateDirectoryMode=0700

# Only the journal, no syslog, no wall.
SyslogIdentifier=bootowser
StandardOutput=journal
StandardError=journal

# multi-user.target, like its two siblings: an image whose default target is
# multi-user would otherwise start the X server and never launch the browser,
# and multi-user is reached earlier than graphical anyway.
[Install]
WantedBy=multi-user.target