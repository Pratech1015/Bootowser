+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+# The Bootowser control sidecar: a small loopback HTTP daemon the kiosk page
+# uses to run commands on the device. It is deliberately not linked against
+# libxul (linkage=None) so that a browser crash cannot take the executor down
+# with it, and so the page's command channel survives a browser restart.
+if CONFIG["OS_TARGET"] != "WINNT":
+    GeckoProgram("bootowser-control", linkage=None)
+
+    SOURCES += [
+        "exec.cpp",
+        "http.cpp",
+        "main.cpp",
+    ]
+
+    # Don't use the STL wrappers; we don't link with -lmozalloc, and it really
+    # doesn't matter here anyway. (Same posture as pingsender.)
+    DisableStlWrapping()
