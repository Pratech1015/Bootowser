new file mode 100644
index 0000000000..eb0d7e2d1b
--- /dev/null
+++ b/toolkit/bootowser-control/control.h
@@ -0,0 +1,41 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef bootowser_control_h__
+#define bootowser_control_h__
+
+#include <string>
+#include <vector>
+
+namespace bootowser {
+
+// Everything the sidecar is configured with. Values come from the
+// environment, which systemd fills from /etc/bootowser/control.conf via
+// EnvironmentFile= in the unit.
+struct Config {
+  int port = 29500;
+  std::string bind_addr = "127.0.0.1";
+  // Comma-separated in ALLOWED_ORIGINS: the origins (scheme://host[:port]) a
+  // browser page must present to reach /v1/*.
+  std::vector<std::string> allowed_origins;
+  std::string token;
+  std::string commands_dir = "/usr/lib/bootowser/commands";
+  long default_timeout_ms = 30000;
+  long max_timeout_ms = 300000;
+  size_t max_output_bytes = 1048576;
+  size_t max_body_bytes = 1048576;
+  int max_concurrent = 16;
+  bool allow_no_origin = false;
+  bool allow_nonloopback = false;
+};
+
+// Reads PORT, BIND, ALLOWED_ORIGINS, TOKEN, COMMANDS_DIR,
+// DEFAULT_TIMEOUT_MS, MAX_TIMEOUT_MS, MAX_OUTPUT_BYTES, MAX_BODY_BYTES,
+// MAX_CONCURRENT, ALLOW_NO_ORIGIN and ALLOW_NONLOOPBACK from the
+// environment. On invalid input returns false and stores a message in *err.
+bool LoadConfig(Config* out, std::string* err);
+
+}  // namespace bootowser
+
+#endif
diff --git a/toolkit/bootowser-control/exec.cpp b/toolkit/bootowser-control/exec.cpp
new file mode 100644
index 0000000000..70e960d66b
--- /dev/null
+++ b/toolkit/bootowser-control/exec.cpp
@@ -0,0 +1,331 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "exec.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <poll.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <algorithm>
+
+namespace bootowser {
+
+namespace {
+
+long long NowMs() {
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return static_cast<long long>(ts.tv_sec) * 1000 +
+         ts.tv_nsec / 1000000LL;
+}
+
+void AppendBounded(std::string* dst, const char* data, size_t len,
+                   size_t cap, bool* truncated) {
+  if (len == 0) {
+    return;
+  }
+  if (dst->size() >= cap) {
+    *truncated = true;
+    return;
+  }
+  size_t room = cap - dst->size();
+  if (len > room) {
+    dst->append(data, room);
+    *truncated = true;
+  } else {
+    dst->append(data, len);
+  }
+}
+
+void CloseIfOpen(int* fd) {
+  if (*fd >= 0) {
+    close(*fd);
+    *fd = -1;
+  }
+}
+
+}  // namespace
+
+ExecResult RunArgv(const std::vector<std::string>& argv, long timeout_ms,
+                   size_t max_output) {
+  ExecResult r;
+  const long long start = NowMs();
+  if (timeout_ms < 1) {
+    timeout_ms = 1;
+  }
+
+  int out_pipe[2] = {-1, -1};
+  int err_pipe[2] = {-1, -1};
+  if (pipe(out_pipe) != 0 || pipe(err_pipe) != 0) {
+    r.err = std::string("pipe: ") + strerror(errno);
+    CloseIfOpen(&out_pipe[0]);
+    CloseIfOpen(&out_pipe[1]);
+    CloseIfOpen(&err_pipe[0]);
+    CloseIfOpen(&err_pipe[1]);
+    return r;
+  }
+
+  pid_t pid = fork();
+  if (pid < 0) {
+    r.err = std::string("fork: ") + strerror(errno);
+    CloseIfOpen(&out_pipe[0]);
+    CloseIfOpen(&out_pipe[1]);
+    CloseIfOpen(&err_pipe[0]);
+    CloseIfOpen(&err_pipe[1]);
+    return r;
+  }
+
+  if (pid == 0) {
+    // Child. Its own process group so a timeout can kill the whole tree
+    // (sh -c 'a | b' and friends), and default signal dispositions: the
+    // listener's SIGCHLD reaper must not run here, or waitpid below would
+    // race with it. Ignored signals are inherited across exec, so reset
+    // those too.
+    setpgid(0, 0);
+    signal(SIGPIPE, SIG_DFL);
+    signal(SIGCHLD, SIG_DFL);
+    signal(SIGTERM, SIG_DFL);
+    signal(SIGINT, SIG_DFL);
+    signal(SIGHUP, SIG_DFL);
+
+    int devnull = open("/dev/null", O_RDONLY);
+    if (devnull >= 0) {
+      dup2(devnull, STDIN_FILENO);
+      close(devnull);
+    }
+    dup2(out_pipe[1], STDOUT_FILENO);
+    dup2(err_pipe[1], STDERR_FILENO);
+    close(out_pipe[0]);
+    close(out_pipe[1]);
+    close(err_pipe[0]);
+    close(err_pipe[1]);
+
+    // A fresh, minimal environment: nothing from the daemon (config file,
+    // token) leaks into a command the page started.
+    std::vector<std::string> env_store;
+    env_store.emplace_back("PATH=/usr/sbin:/usr/bin:/sbin:/bin");
+    const char* home = getenv("HOME");
+    env_store.emplace_back(std::string("HOME=") +
+                           (home && *home ? home : "/var/lib/bootowser"));
+    std::vector<char*> envp;
+    envp.reserve(env_store.size() + 1);
+    for (std::string& s : env_store) {
+      envp.push_back(const_cast<char*>(s.c_str()));
+    }
+    envp.push_back(nullptr);
+
+    std::vector<char*> cargv;
+    cargv.reserve(argv.size() + 1);
+    for (const std::string& a : argv) {
+      cargv.push_back(const_cast<char*>(a.c_str()));
+    }
+    cargv.push_back(nullptr);
+
+    execv(argv[0].c_str(), cargv.data());
+    fprintf(stderr, "bootowser-control: execv %s: %s\n", argv[0].c_str(),
+            strerror(errno));
+    _exit(127);
+  }
+
+  // Parent (a connection child of the listener).
+  close(out_pipe[1]);
+  close(err_pipe[1]);
+  // Win the setpgid race against the child (either order is legal).
+  setpgid(pid, pid);
+
+  for (int* fd : {&out_pipe[0], &err_pipe[0]}) {
+    int flags = fcntl(*fd, F_GETFL, 0);
+    if (flags >= 0) {
+      fcntl(*fd, F_SETFL, flags | O_NONBLOCK);
+    }
+  }
+
+  bool child_reaped = false;
+  int child_status = 0;
+  int term_state = 0;  // 0 running, 1 SIGTERM sent, 2 SIGKILL sent
+  long long state_until = start + timeout_ms;
+  bool grace_set = false;
+  char buf[4096];
+
+  for (;;) {
+    // Reap first so a child exiting exactly at its deadline is not counted
+    // as a timeout.
+    if (!child_reaped) {
+      pid_t w = waitpid(pid, &child_status, WNOHANG);
+      if (w == pid) {
+        child_reaped = true;
+        if ((out_pipe[0] >= 0 || err_pipe[0] >= 0) && term_state == 0 &&
+            !grace_set) {
+          // The command finished but something it spawned still holds the
+          // output pipes open. Give it a moment, then kill the group.
+          grace_set = true;
+          state_until = std::min(state_until, NowMs() + 1000);
+        }
+      }
+    }
+    if (child_reaped && out_pipe[0] < 0 && err_pipe[0] < 0) {
+      break;
+    }
+
+    long long now = NowMs();
+    if (now >= state_until) {
+      if (term_state == 0) {
+        r.timed_out = !child_reaped;
+        kill(-pid, SIGTERM);
+        term_state = 1;
+        state_until = NowMs() + 1500;
+      } else if (term_state == 1) {
+        kill(-pid, SIGKILL);
+        term_state = 2;
+        state_until = NowMs() + 2000;
+      } else {
+        // SIGKILL was already sent; the group is gone, nothing more to do.
+        break;
+      }
+      continue;
+    }
+
+    struct pollfd pfds[2];
+    nfds_t nfds = 0;
+    if (out_pipe[0] >= 0) {
+      pfds[nfds++] = {out_pipe[0], POLLIN, 0};
+    }
+    if (err_pipe[0] >= 0) {
+      pfds[nfds++] = {err_pipe[0], POLLIN, 0};
+    }
+    int wait_ms = static_cast<int>(
+        std::min<long long>(state_until - now, 200));
+    int ready = poll(pfds, nfds, wait_ms);
+    if (ready < 0 && errno != EINTR) {
+      break;
+    }
+
+    struct {
+      int* fd;
+      std::string* dst;
+      bool* truncated;
+    } lanes[2] = {{&out_pipe[0], &r.out, &r.truncated},
+                  {&err_pipe[0], &r.err, &r.truncated}};
+    for (auto& lane : lanes) {
+      if (*lane.fd < 0) {
+        continue;
+      }
+      for (;;) {
+        ssize_t n = read(*lane.fd, buf, sizeof(buf));
+        if (n > 0) {
+          AppendBounded(lane.dst, buf, static_cast<size_t>(n), max_output,
+                        lane.truncated);
+          continue;
+        }
+        if (n == 0) {
+          CloseIfOpen(lane.fd);
+        } else if (errno == EAGAIN || errno == EWOULDBLOCK) {
+          // Nothing buffered right now.
+        } else if (errno != EINTR) {
+          CloseIfOpen(lane.fd);
+        }
+        break;
+      }
+    }
+  }
+
+  // The state machine guarantees the child is dead here except if we left
+  // the loop abnormally; make sure it is dead and reaped either way.
+  if (!child_reaped) {
+    kill(-pid, SIGKILL);
+  }
+  while (!child_reaped) {
+    pid_t w = waitpid(pid, &child_status, WNOHANG);
+    if (w == pid) {
+      child_reaped = true;
+      break;
+    }
+    if (w < 0 && errno != EINTR) {
+      break;
+    }
+    struct timespec ts = {0, 10 * 1000 * 1000};
+    nanosleep(&ts, nullptr);
+  }
+  CloseIfOpen(&out_pipe[0]);
+  CloseIfOpen(&err_pipe[0]);
+
+  r.started = true;
+  if (child_reaped) {
+    if (WIFEXITED(child_status)) {
+      r.exit_code = WEXITSTATUS(child_status);
+    } else if (WIFSIGNALED(child_status)) {
+      r.exit_code = 128 + WTERMSIG(child_status);
+    }
+  }
+  r.duration_ms = static_cast<long>(NowMs() - start);
+  return r;
+}
+
+ExecResult RunShell(const std::string& cmd, long timeout_ms,
+                    size_t max_output) {
+  return RunArgv({"/bin/sh", "-c", cmd}, timeout_ms, max_output);
+}
+
+bool ValidateCommandName(const std::string& name) {
+  if (name.empty() || name.size() > 64 || name[0] == '.') {
+    return false;
+  }
+  for (char c : name) {
+    bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+              (c >= '0' && c <= '9') || c == '.' || c == '_' || c == '-';
+    if (!ok) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool RunRoot(const std::string& name, const std::vector<std::string>& args,
+             const std::string& commands_dir, long timeout_ms,
+             size_t max_output, ExecResult* result, std::string* error) {
+  if (!ValidateCommandName(name)) {
+    *error = "invalid command name";
+    return false;
+  }
+  std::string path = commands_dir + "/" + name;
+  struct stat st;
+  if (lstat(path.c_str(), &st) != 0) {
+    *error = "no such command";
+    return false;
+  }
+  if (!S_ISREG(st.st_mode)) {
+    *error = "not a regular file";
+    return false;
+  }
+  if (st.st_uid != 0) {
+    *error = "command must be owned by root";
+    return false;
+  }
+  if (st.st_mode & (S_IWGRP | S_IWOTH)) {
+    *error = "command must not be group or world writable";
+    return false;
+  }
+  if (access(path.c_str(), X_OK) != 0) {
+    *error = "command is not executable";
+    return false;
+  }
+
+  std::vector<std::string> argv = {"/usr/bin/sudo", "-n", path};
+  argv.insert(argv.end(), args.begin(), args.end());
+  *result = RunArgv(argv, timeout_ms, max_output);
+  return true;
+}
+
+}  // namespace bootowser
diff --git a/toolkit/bootowser-control/exec.h b/toolkit/bootowser-control/exec.h
new file mode 100644
index 0000000000..db2cd061c7
--- /dev/null
+++ b/toolkit/bootowser-control/exec.h
@@ -0,0 +1,50 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef bootowser_exec_h__
+#define bootowser_exec_h__
+
+#include <string>
+#include <vector>
+
+namespace bootowser {
+
+struct ExecResult {
+  // Wait status as an exit code: WEXITSTATUS, or 128+signal when killed.
+  int exit_code = -1;
+  bool timed_out = false;
+  bool truncated = false;
+  // False when the child could not be started at all; then out/err carry the
+  // errno-based message instead of command output.
+  bool started = false;
+  long duration_ms = 0;
+  std::string out;
+  std::string err;
+};
+
+// Runs argv (argv[0] is the absolute path of the program) with a minimal
+// fresh environment (PATH, HOME), in its own process group, capturing
+// stdout/stderr up to max_output bytes each. On timeout the whole process
+// group gets SIGTERM, then SIGKILL after a short grace period.
+ExecResult RunArgv(const std::vector<std::string>& argv, long timeout_ms,
+                   size_t max_output);
+
+// Convenience: /bin/sh -c cmd.
+ExecResult RunShell(const std::string& cmd, long timeout_ms,
+                    size_t max_output);
+
+// True for a safe commands.d entry name: letters, digits, dot, underscore,
+// dash; no leading dot; bounded length.
+bool ValidateCommandName(const std::string& name);
+
+// Validates a root-hook request and, when the checks pass, runs
+// `sudo -n <commands_dir>/<name> [args...]`.
+// On validation failure returns false and stores a human message in *error.
+bool RunRoot(const std::string& name, const std::vector<std::string>& args,
+             const std::string& commands_dir, long timeout_ms,
+             size_t max_output, ExecResult* result, std::string* error);
+
+}  // namespace bootowser
+
+#endif
diff --git a/toolkit/bootowser-control/http.cpp b/toolkit/bootowser-control/http.cpp
new file mode 100644
index 0000000000..8afd4fdf95
--- /dev/null
+++ b/toolkit/bootowser-control/http.cpp
@@ -0,0 +1,365 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#include "http.h"
+
+#include <arpa/inet.h>
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+
+namespace bootowser {
+
+namespace {
+
+std::string TrimOws(const std::string& s) {
+  size_t begin = 0;
+  size_t end = s.size();
+  while (begin < end && (s[begin] == ' ' || s[begin] == '\t')) {
+    ++begin;
+  }
+  while (end > begin && (s[end - 1] == ' ' || s[end - 1] == '\t')) {
+    --end;
+  }
+  return s.substr(begin, end - begin);
+}
+
+std::string ToLower(const std::string& s) {
+  std::string out = s;
+  for (char& c : out) {
+    if (c >= 'A' && c <= 'Z') {
+      c = static_cast<char>(c - 'A' + 'a');
+    }
+  }
+  return out;
+}
+
+int HexValue(char c) {
+  if (c >= '0' && c <= '9') {
+    return c - '0';
+  }
+  if (c >= 'a' && c <= 'f') {
+    return c - 'a' + 10;
+  }
+  if (c >= 'A' && c <= 'F') {
+    return c - 'A' + 10;
+  }
+  return -1;
+}
+
+// Parses the header block (request line plus header lines, CRLF-terminated).
+bool ParseHead(const std::string& head, HttpRequest* out) {
+  size_t line_end = head.find("\r\n");
+  std::string request_line = head.substr(0, line_end);
+  size_t sp1 = request_line.find(' ');
+  size_t sp2 = sp1 == std::string::npos ? std::string::npos
+                                        : request_line.find(' ', sp1 + 1);
+  if (sp1 == std::string::npos || sp2 == std::string::npos) {
+    return false;
+  }
+  out->method = request_line.substr(0, sp1);
+  out->target = request_line.substr(sp1 + 1, sp2 - sp1 - 1);
+  std::string version = request_line.substr(sp2 + 1);
+  if (version.compare(0, 5, "HTTP/") != 0 || out->method.empty() ||
+      out->target.empty()) {
+    return false;
+  }
+
+  size_t pos = line_end;
+  if (pos == std::string::npos) {
+    return true;  // request line only, no headers
+  }
+  pos += 2;  // skip CRLF
+  while (pos < head.size()) {
+    line_end = head.find("\r\n", pos);
+    if (line_end == std::string::npos) {
+      line_end = head.size();
+    }
+    std::string line = head.substr(pos, line_end - pos);
+    pos = line_end + 2;
+    if (line.empty()) {
+      break;
+    }
+    // Reject obs-fold: continuation lines are a request-smuggling vector.
+    if (line[0] == ' ' || line[0] == '\t') {
+      return false;
+    }
+    size_t colon = line.find(':');
+    if (colon == std::string::npos || colon == 0) {
+      return false;
+    }
+    out->headers.emplace_back(ToLower(line.substr(0, colon)),
+                              TrimOws(line.substr(colon + 1)));
+  }
+  return true;
+}
+
+bool RecvMore(int fd, std::string* buf, char* tmp, size_t tmp_size,
+              ReadStatus* status) {
+  for (;;) {
+    ssize_t n = recv(fd, tmp, tmp_size, 0);
+    if (n > 0) {
+      buf->append(tmp, static_cast<size_t>(n));
+      return true;
+    }
+    if (n == 0) {
+      *status = ReadStatus::Closed;
+      return false;
+    }
+    if (errno == EINTR) {
+      continue;
+    }
+    if (errno == EAGAIN || errno == EWOULDBLOCK) {
+      *status = ReadStatus::TimedOut;
+      return false;
+    }
+    *status = ReadStatus::Malformed;
+    return false;
+  }
+}
+
+}  // namespace
+
+const std::string* HttpRequest::FindHeader(const std::string& name) const {
+  for (const auto& header : headers) {
+    if (header.first == name) {
+      return &header.second;
+    }
+  }
+  return nullptr;
+}
+
+ReadStatus ReadRequest(int fd, size_t max_header, size_t max_body,
+                       HttpRequest* out) {
+  std::string buf;
+  char tmp[4096];
+  ReadStatus status = ReadStatus::Malformed;
+
+  for (;;) {
+    size_t pos = buf.find("\r\n\r\n");
+    if (pos != std::string::npos) {
+      if (!ParseHead(buf.substr(0, pos + 2), out)) {
+        return ReadStatus::Malformed;
+      }
+      break;
+    }
+    if (buf.size() > max_header) {
+      return ReadStatus::HeaderTooLarge;
+    }
+    if (!RecvMore(fd, &buf, tmp, sizeof(tmp), &status)) {
+      return status;
+    }
+  }
+
+  if (const std::string* te = out->FindHeader("transfer-encoding")) {
+    if (!te->empty() && *te != "identity") {
+      return ReadStatus::Unsupported;
+    }
+  }
+
+  size_t content_length = 0;
+  bool seen_length = false;
+  for (const auto& header : out->headers) {
+    if (header.first != "content-length") {
+      continue;
+    }
+    if (seen_length) {
+      return ReadStatus::Malformed;  // duplicate Content-Length: smuggling
+    }
+    seen_length = true;
+    for (char c : header.second) {
+      if (c < '0' || c > '9') {
+        return ReadStatus::Malformed;
+      }
+    }
+    content_length = static_cast<size_t>(strtoul(header.second.c_str(),
+                                                 nullptr, 10));
+  }
+  if (content_length > max_body) {
+    return ReadStatus::BodyTooLarge;
+  }
+
+  size_t header_bytes = buf.find("\r\n\r\n") + 4;
+  size_t need = header_bytes + content_length;
+  while (buf.size() < need) {
+    if (!RecvMore(fd, &buf, tmp, sizeof(tmp), &status)) {
+      return status;
+    }
+  }
+  out->body = buf.substr(header_bytes, content_length);
+  return ReadStatus::Ok;
+}
+
+const char* ReadStatusText(ReadStatus status) {
+  switch (status) {
+    case ReadStatus::Ok:
+      return "200 OK";
+    case ReadStatus::Closed:
+      return "400 Bad Request";
+    case ReadStatus::TimedOut:
+      return "408 Request Timeout";
+    case ReadStatus::HeaderTooLarge:
+      return "431 Request Header Fields Too Large";
+    case ReadStatus::BodyTooLarge:
+      return "413 Payload Too Large";
+    case ReadStatus::Unsupported:
+      return "501 Not Implemented";
+    case ReadStatus::Malformed:
+      break;
+  }
+  return "400 Bad Request";
+}
+
+bool UrlDecode(const std::string& in, bool plus_as_space, std::string* out) {
+  out->clear();
+  out->reserve(in.size());
+  for (size_t i = 0; i < in.size(); ++i) {
+    char c = in[i];
+    if (plus_as_space && c == '+') {
+      out->push_back(' ');
+      continue;
+    }
+    if (c != '%') {
+      out->push_back(c);
+      continue;
+    }
+    if (i + 2 >= in.size()) {
+      return false;
+    }
+    int hi = HexValue(in[i + 1]);
+    int lo = HexValue(in[i + 2]);
+    if (hi < 0 || lo < 0) {
+      return false;
+    }
+    out->push_back(static_cast<char>((hi << 4) | lo));
+    i += 2;
+  }
+  return true;
+}
+
+std::vector<std::pair<std::string, std::string>> ParseForm(
+    const std::string& body) {
+  std::vector<std::pair<std::string, std::string>> out;
+  size_t pos = 0;
+  while (pos <= body.size()) {
+    size_t amp = body.find('&', pos);
+    if (amp == std::string::npos) {
+      amp = body.size();
+    }
+    std::string field = body.substr(pos, amp - pos);
+    size_t eq = field.find('=');
+    std::string raw_key = field.substr(0, eq);
+    std::string raw_value =
+        eq == std::string::npos ? std::string() : field.substr(eq + 1);
+    std::string key, value;
+    if (UrlDecode(raw_key, true, &key) && UrlDecode(raw_value, true, &value)) {
+      out.emplace_back(key, value);
+    }
+    pos = amp + 1;
+  }
+  return out;
+}
+
+const std::string* FormValue(
+    const std::vector<std::pair<std::string, std::string>>& form,
+    const std::string& key) {
+  for (const auto& field : form) {
+    if (field.first == key) {
+      return &field.second;
+    }
+  }
+  return nullptr;
+}
+
+std::string JsonEscape(const std::string& in) {
+  std::string out;
+  out.reserve(in.size() + 8);
+  for (unsigned char c : in) {
+    switch (c) {
+      case '"':
+        out += "\\\"";
+        break;
+      case '\\':
+        out += "\\\\";
+        break;
+      case '\b':
+        out += "\\b";
+        break;
+      case '\f':
+        out += "\\f";
+        break;
+      case '\n':
+        out += "\\n";
+        break;
+      case '\r':
+        out += "\\r";
+        break;
+      case '\t':
+        out += "\\t";
+        break;
+      default:
+        if (c < 0x20) {
+          char buf[8];
+          snprintf(buf, sizeof(buf), "\\u%04x", c);
+          out += buf;
+        } else {
+          out.push_back(static_cast<char>(c));
+        }
+    }
+  }
+  return out;
+}
+
+std::string PathOnly(const std::string& target) {
+  size_t q = target.find('?');
+  return q == std::string::npos ? target : target.substr(0, q);
+}
+
+std::string HttpResponse(int status, const char* reason,
+                         const std::string& content_type,
+                         const std::string& body,
+                         const std::string& cors_origin,
+                         const std::string& extra_headers) {
+  std::string out;
+  char line[128];
+  snprintf(line, sizeof(line), "HTTP/1.1 %d %s\r\n", status, reason);
+  out += line;
+  out += "Content-Type: ";
+  out += content_type;
+  out += "\r\nContent-Length: ";
+  out += std::to_string(body.size());
+  out += "\r\nConnection: close\r\nCache-Control: no-store\r\n";
+  out += extra_headers;
+  if (!cors_origin.empty()) {
+    out += "Access-Control-Allow-Origin: ";
+    out += cors_origin;
+    out += "\r\nVary: Origin\r\n";
+  }
+  out += "\r\n";
+  out += body;
+  return out;
+}
+
+std::string HttpOptionsResponse(const std::string& cors_origin) {
+  std::string out =
+      "HTTP/1.1 204 No Content\r\n"
+      "Connection: close\r\nCache-Control: no-store\r\n";
+  if (!cors_origin.empty()) {
+    out += "Access-Control-Allow-Origin: ";
+    out += cors_origin;
+    out += "\r\nAccess-Control-Allow-Methods: GET, POST, OPTIONS\r\n";
+    out += "Access-Control-Allow-Headers: Content-Type, "
+           "X-Bootowser-Token\r\n";
+    out += "Access-Control-Max-Age: 86400\r\n";
+    // Chrome's Private Network Access handshake; harmless to Firefox.
+    out += "Access-Control-Allow-Private-Network: true\r\n";
+    out += "Vary: Origin\r\n";
+  }
+  out += "\r\n";
+  return out;
+}
+
+}  // namespace bootowser
diff --git a/toolkit/bootowser-control/http.h b/toolkit/bootowser-control/http.h
new file mode 100644
index 0000000000..19e09faae8
--- /dev/null
+++ b/toolkit/bootowser-control/http.h
@@ -0,0 +1,78 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+#ifndef bootowser_http_h__
+#define bootowser_http_h__
+
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace bootowser {
+
+struct HttpRequest {
+  std::string method;    // "GET", "POST", ...
+  std::string target;    // "/v1/exec?x=1" as sent
+  std::vector<std::pair<std::string, std::string>> headers;  // keys lowercased
+  std::string body;
+
+  // Returns the value of the first header with this (lowercase) name, or
+  // nullptr when absent.
+  const std::string* FindHeader(const std::string& name) const;
+};
+
+enum class ReadStatus {
+  Ok,
+  Closed,
+  TimedOut,
+  HeaderTooLarge,
+  BodyTooLarge,
+  Unsupported,
+  Malformed,
+};
+
+// Reads exactly one HTTP/1.x request (headers plus a Content-Length body)
+// from fd. One request per connection; the caller closes afterwards.
+ReadStatus ReadRequest(int fd, size_t max_header, size_t max_body,
+                       HttpRequest* out);
+
+// Human-readable phrase for a failed ReadStatus ("413 Payload Too Large").
+const char* ReadStatusText(ReadStatus status);
+
+// application/x-www-form-urlencoded decoding. Returns false on a malformed
+// %-escape.
+bool UrlDecode(const std::string& in, bool plus_as_space, std::string* out);
+
+// Parses a form body into ordered (key, value) pairs; repeated keys are
+// preserved.
+std::vector<std::pair<std::string, std::string>> ParseForm(
+    const std::string& body);
+
+// First value for key in a parsed form, or nullptr.
+const std::string* FormValue(
+    const std::vector<std::pair<std::string, std::string>>& form,
+    const std::string& key);
+
+std::string JsonEscape(const std::string& in);
+
+// Strips the query string: "/v1/exec?x=1" -> "/v1/exec".
+std::string PathOnly(const std::string& target);
+
+// A complete response: status line, Content-Length, Connection: close and
+// (when cors_origin is non-empty) the CORS headers a browser needs to read
+// the body. cors_origin must already have passed the origin gate.
+// extra_headers is appended verbatim (each line must end with CRLF).
+std::string HttpResponse(int status, const char* reason,
+                         const std::string& content_type,
+                         const std::string& body,
+                         const std::string& cors_origin,
+                         const std::string& extra_headers = "");
+
+// The preflight answer: 204 with Access-Control-* headers. cors_origin must
+// already have passed the origin gate.
+std::string HttpOptionsResponse(const std::string& cors_origin);
+
+}  // namespace bootowser
+
+#endif
diff --git a/toolkit/bootowser-control/main.cpp b/toolkit/bootowser-control/main.cpp
new file mode 100644
index 0000000000..9e017d2d9d
--- /dev/null
+++ b/toolkit/bootowser-control/main.cpp
@@ -0,0 +1,743 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// The Bootowser control sidecar: a loopback-only HTTP daemon that lets the
+// kiosk page (and a local operator) run commands on the device.
+//
+//   GET  /healthz        liveness probe
+//   GET  /v1/commands    the root-hook scripts in COMMANDS_DIR
+//   POST /v1/exec        arbitrary shell, as the kiosk user (form: cmd=...)
+//   POST /v1/root        an allowlisted root script (form: name=...&arg=...)
+//   GET  /               a small same-origin admin console
+//
+// /v1/* requires an Origin from ALLOWED_ORIGINS (or a valid X-Bootowser-Token
+// for token-less callers such as curl). See docs/control.md.
+
+#include <arpa/inet.h>
+#include <cstdint>
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <atomic>
+#include <string>
+#include <vector>
+
+#include "control.h"
+#include "exec.h"
+#include "http.h"
+
+namespace bootowser {
+
+namespace {
+
+constexpr size_t kMaxHeaderBytes = 65536;
+constexpr size_t kMaxCmdBytes = 65536;
+constexpr size_t kMaxArgBytes = 4096;
+constexpr size_t kMaxArgsTotalBytes = 16384;
+constexpr int kMaxArgs = 32;
+constexpr int kIoTimeoutSeconds = 10;
+
+Config g_config;
+std::atomic<int> g_active{0};
+volatile sig_atomic_t g_running = 1;
+
+void OnSigChld(int) {
+  int status;
+  while (waitpid(-1, &status, WNOHANG) > 0) {
+    g_active.fetch_sub(1, std::memory_order_relaxed);
+  }
+}
+
+void OnTerm(int) { g_running = 0; }
+
+bool WriteAll(int fd, const std::string& data) {
+  size_t sent = 0;
+  while (sent < data.size()) {
+    ssize_t n = send(fd, data.data() + sent, data.size() - sent, MSG_NOSIGNAL);
+    if (n > 0) {
+      sent += static_cast<size_t>(n);
+      continue;
+    }
+    if (n < 0 && errno == EINTR) {
+      continue;
+    }
+    return false;
+  }
+  return true;
+}
+
+std::string PortString(int port) { return std::to_string(port); }
+
+bool OriginAllowed(const Config& cfg, const std::string& origin) {
+  if (origin.empty()) {
+    return false;
+  }
+  if (origin == "http://127.0.0.1:" + PortString(cfg.port) ||
+      origin == "http://localhost:" + PortString(cfg.port)) {
+    return true;
+  }
+  return std::find(cfg.allowed_origins.begin(), cfg.allowed_origins.end(),
+                   origin) != cfg.allowed_origins.end();
+}
+
+bool TokenOk(const Config& cfg, const HttpRequest& req) {
+  if (cfg.token.empty()) {
+    return false;
+  }
+  const std::string* token = req.FindHeader("x-bootowser-token");
+  return token && *token == cfg.token;
+}
+
+std::string JsonError(const std::string& message) {
+  return "{\"ok\":false,\"error\":\"" + JsonEscape(message) + "\"}";
+}
+
+void SendJson(int fd, int status, const char* reason, const std::string& body,
+              const std::string& cors,
+              const std::string& extra = std::string()) {
+  WriteAll(fd, HttpResponse(status, reason, "application/json; charset=utf-8",
+                            body, cors, extra));
+}
+
+std::string AuditField(const std::string& in) {
+  // One line in the journal: strip control characters so a command cannot
+  // forge log lines.
+  std::string out;
+  for (char c : in) {
+    if (c == '\n' || c == '\r' || c == '\t') {
+      out.push_back(' ');
+    } else if (static_cast<unsigned char>(c) < 0x20) {
+      out.push_back('?');
+    } else {
+      out.push_back(c);
+    }
+    if (out.size() >= 200) {
+      break;
+    }
+  }
+  return out;
+}
+
+const char* kAdminPage =
+    "<!doctype html>\n"
+    "<html lang=\"en\"><head><meta charset=\"utf-8\">"
+    "<title>Bootowser control</title>\n"
+    "<style>"
+    "body{font:14px/1.5 system-ui,sans-serif;background:#1c1b22;color:#f9f9"
+    "fa;margin:2rem;max-width:64rem}"
+    "input,select,button{font:inherit;padding:.35rem .5rem;background:#2b2a"
+    "33;color:inherit;border:1px solid #5b5a66;border-radius:4px}"
+    "button{cursor:pointer}"
+    "#out{white-space:pre-wrap;background:#141318;padding:1rem;border-radius"
+    ":6px;min-height:6rem}"
+    "h1{font-size:1.1rem}label{margin-right:.5rem}"
+    "</style></head><body>\n"
+    "<h1>Bootowser control</h1>\n"
+    "<p><label for=\"mode\">as</label>"
+    "<select id=\"mode\">"
+    "<option value=\"shell\">shell (kiosk user)</option>"
+    "<option value=\"root\">root script</option></select> "
+    "<input id=\"cmd\" size=\"48\" placeholder=\"command or script name\"> "
+    "<input id=\"args\" size=\"24\" placeholder=\"args (root, space "
+    "separated)\"> "
+    "<button id=\"run\">Run</button></p>\n"
+    "<pre id=\"out\">ready</pre>\n"
+    "<script>\n"
+    "const $=id=>document.getElementById(id);\n"
+    "$('run').onclick=async()=>{\n"
+    "  const mode=$('mode').value, cmd=$('cmd').value, args=$('args').value;\n"
+    "  let url, body;\n"
+    "  if(mode==='shell'){\n"
+    "    url='/v1/exec'; body='cmd='+encodeURIComponent(cmd);\n"
+    "  } else {\n"
+    "    url='/v1/root'; body='name='+encodeURIComponent(cmd);\n"
+    "    for(const a of args.split(/\\s+/).filter(Boolean))\n"
+    "      body+='&arg='+encodeURIComponent(a);\n"
+    "  }\n"
+    "  $('out').textContent='running\\u2026';\n"
+    "  try{\n"
+    "    const r=await fetch(url,{method:'POST',\n"
+    "      headers:{'Content-Type':'application/x-www-form-urlencoded'},\n"
+    "      body});\n"
+    "    $('out').textContent=JSON.stringify(await r.json(),null,2);\n"
+    "  }catch(e){ $('out').textContent='error: '+e; }\n"
+    "};\n"
+    "</script></body></html>\n";
+
+void HandleGetRoot(int fd, const std::string& cors) {
+  // The console only ever talks to its own origin, so lock it down hard.
+  const std::string extra =
+      "Content-Security-Policy: default-src 'none'; connect-src 'self'; "
+      "style-src 'unsafe-inline'; script-src 'unsafe-inline'\r\n"
+      "X-Frame-Options: DENY\r\n";
+  WriteAll(fd, HttpResponse(200, "OK", "text/html; charset=utf-8", kAdminPage,
+                            cors, extra));
+}
+
+void HandleHealthz(int fd, const std::string& cors) {
+  SendJson(fd, 200, "OK", "{\"ok\":true,\"api\":1}", cors);
+}
+
+void HandleCommands(int fd, const Config& cfg, const std::string& cors) {
+  std::vector<std::string> names;
+  DIR* dir = opendir(cfg.commands_dir.c_str());
+  if (!dir) {
+    SendJson(fd, 500, "Internal Server Error",
+             JsonError("commands directory unavailable"), cors);
+    return;
+  }
+  struct dirent* entry;
+  while ((entry = readdir(dir)) != nullptr) {
+    std::string name = entry->d_name;
+    if (!ValidateCommandName(name)) {
+      continue;
+    }
+    std::string path = cfg.commands_dir + "/" + name;
+    struct stat st;
+    if (lstat(path.c_str(), &st) != 0 || !S_ISREG(st.st_mode) ||
+        st.st_uid != 0 || (st.st_mode & (S_IWGRP | S_IWOTH)) ||
+        access(path.c_str(), X_OK) != 0) {
+      continue;
+    }
+    names.push_back(name);
+  }
+  closedir(dir);
+  std::sort(names.begin(), names.end());
+
+  std::string body = "{\"ok\":true,\"commands\":[";
+  for (size_t i = 0; i < names.size(); ++i) {
+    if (i) {
+      body += ",";
+    }
+    body += "\"" + JsonEscape(names[i]) + "\"";
+  }
+  body += "]}";
+  SendJson(fd, 200, "OK", body, cors);
+}
+
+bool ParseTimeoutMs(const Config& cfg,
+                    const std::vector<std::pair<std::string, std::string>>&
+                        form,
+                    long* out, std::string* err) {
+  *out = cfg.default_timeout_ms;
+  const std::string* raw = FormValue(form, "timeout_ms");
+  if (!raw) {
+    return true;
+  }
+  errno = 0;
+  char* end = nullptr;
+  long value = strtol(raw->c_str(), &end, 10);
+  if (errno || end == raw->c_str() || *end != '\0') {
+    *err = "timeout_ms must be an integer";
+    return false;
+  }
+  *out = std::max(1L, std::min(value, cfg.max_timeout_ms));
+  return true;
+}
+
+void HandleExec(int fd, const Config& cfg, const HttpRequest& req,
+                const std::string& cors) {
+  std::vector<std::pair<std::string, std::string>> form =
+      ParseForm(req.body);
+  const std::string* cmd = FormValue(form, "cmd");
+  if (!cmd || cmd->empty()) {
+    SendJson(fd, 400, "Bad Request", JsonError("missing cmd"), cors);
+    return;
+  }
+  if (cmd->size() > kMaxCmdBytes) {
+    SendJson(fd, 400, "Bad Request", JsonError("cmd too long"), cors);
+    return;
+  }
+  long timeout_ms;
+  std::string err;
+  if (!ParseTimeoutMs(cfg, form, &timeout_ms, &err)) {
+    SendJson(fd, 400, "Bad Request", JsonError(err), cors);
+    return;
+  }
+
+  ExecResult r = RunShell(*cmd, timeout_ms, cfg.max_output_bytes);
+
+  std::string body = "{\"ok\":";
+  if (!r.started) {
+    body = "{\"ok\":false,\"error\":\"" + JsonEscape(r.err) + "\"}";
+    fprintf(stderr,
+            "bootowser-control: exec failed origin=%s error=%s cmd=%s\n",
+            cors.empty() ? "-" : cors.c_str(), AuditField(r.err).c_str(),
+            AuditField(*cmd).c_str());
+    SendJson(fd, 500, "Internal Server Error", body, cors);
+    return;
+  }
+  body += "true,\"exit\":" + std::to_string(r.exit_code);
+  body += ",\"timed_out\":";
+  body += r.timed_out ? "true" : "false";
+  body += ",\"truncated\":";
+  body += r.truncated ? "true" : "false";
+  body += ",\"duration_ms\":" + std::to_string(r.duration_ms);
+  body += ",\"stdout\":\"" + JsonEscape(r.out) + "\"";
+  body += ",\"stderr\":\"" + JsonEscape(r.err) + "\"}";
+
+  fprintf(stderr,
+          "bootowser-control: exec origin=%s exit=%d timed_out=%d ms=%ld "
+          "cmd=%s\n",
+          cors.empty() ? "-" : cors.c_str(), r.exit_code,
+          r.timed_out ? 1 : 0, r.duration_ms, AuditField(*cmd).c_str());
+  SendJson(fd, 200, "OK", body, cors);
+}
+
+void HandleRoot(int fd, const Config& cfg, const HttpRequest& req,
+                const std::string& cors) {
+  std::vector<std::pair<std::string, std::string>> form =
+      ParseForm(req.body);
+  const std::string* name = FormValue(form, "name");
+  if (!name || name->empty()) {
+    SendJson(fd, 400, "Bad Request", JsonError("missing name"), cors);
+    return;
+  }
+
+  std::vector<std::string> args;
+  size_t args_bytes = 0;
+  for (const auto& field : form) {
+    if (field.first != "arg") {
+      continue;
+    }
+    if (static_cast<int>(args.size()) >= kMaxArgs ||
+        field.second.size() > kMaxArgBytes ||
+        args_bytes + field.second.size() > kMaxArgsTotalBytes) {
+      SendJson(fd, 400, "Bad Request", JsonError("too many or too large "
+                                                 "arguments"),
+               cors);
+      return;
+    }
+    args_bytes += field.second.size();
+    args.push_back(field.second);
+  }
+
+  long timeout_ms;
+  std::string err;
+  if (!ParseTimeoutMs(cfg, form, &timeout_ms, &err)) {
+    SendJson(fd, 400, "Bad Request", JsonError(err), cors);
+    return;
+  }
+
+  if (access("/usr/bin/sudo", X_OK) != 0) {
+    SendJson(fd, 503, "Service Unavailable",
+             JsonError("sudo is not installed"), cors);
+    return;
+  }
+
+  ExecResult r;
+  if (!RunRoot(*name, args, cfg.commands_dir, timeout_ms,
+               cfg.max_output_bytes, &r, &err)) {
+    SendJson(fd, 400, "Bad Request", JsonError(err), cors);
+    return;
+  }
+
+  std::string body = "{\"ok\":";
+  if (!r.started) {
+    body = "{\"ok\":false,\"error\":\"" + JsonEscape(r.err) + "\"}";
+    fprintf(stderr,
+            "bootowser-control: root failed origin=%s error=%s name=%s\n",
+            cors.empty() ? "-" : cors.c_str(), AuditField(r.err).c_str(),
+            AuditField(*name).c_str());
+    SendJson(fd, 500, "Internal Server Error", body, cors);
+    return;
+  }
+  body += "true,\"exit\":" + std::to_string(r.exit_code);
+  body += ",\"timed_out\":";
+  body += r.timed_out ? "true" : "false";
+  body += ",\"truncated\":";
+  body += r.truncated ? "true" : "false";
+  body += ",\"duration_ms\":" + std::to_string(r.duration_ms);
+  body += ",\"stdout\":\"" + JsonEscape(r.out) + "\"";
+  body += ",\"stderr\":\"" + JsonEscape(r.err) + "\"}";
+
+  fprintf(stderr,
+          "bootowser-control: root origin=%s name=%s exit=%d timed_out=%d "
+          "ms=%ld args=%zu\n",
+          cors.empty() ? "-" : cors.c_str(), AuditField(*name).c_str(),
+          r.exit_code, r.timed_out ? 1 : 0, r.duration_ms, args.size());
+  SendJson(fd, 200, "OK", body, cors);
+}
+
+// Returns false when the request must not be answered (nothing was sent is
+// handled internally); always writes a response.
+void HandleConnection(int fd, const Config& cfg) {
+  struct timeval tv = {kIoTimeoutSeconds, 0};
+  setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+  setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+
+  HttpRequest req;
+  ReadStatus rs = ReadRequest(fd, kMaxHeaderBytes, cfg.max_body_bytes, &req);
+  if (rs != ReadStatus::Ok) {
+    const char* text = ReadStatusText(rs);
+    int status = atoi(text);
+    SendJson(fd, status, text + 4, JsonError("malformed request"), "");
+    fprintf(stderr, "bootowser-control: bad request status=%s\n", text);
+    return;
+  }
+
+  const std::string path = PathOnly(req.target);
+  const std::string* origin_hdr = req.FindHeader("origin");
+  const std::string origin = origin_hdr ? *origin_hdr : std::string();
+
+  // CORS preflight (and nothing else) for OPTIONS.
+  if (req.method == "OPTIONS") {
+    if (OriginAllowed(cfg, origin)) {
+      WriteAll(fd, HttpOptionsResponse(origin));
+    } else {
+      SendJson(fd, 403, "Forbidden", JsonError("origin not allowed"), "");
+    }
+    return;
+  }
+
+  if (path == "/healthz" || path == "/") {
+    if (req.method != "GET") {
+      SendJson(fd, 405, "Method Not Allowed", JsonError("GET only"),
+               OriginAllowed(cfg, origin) ? origin : "");
+      return;
+    }
+    if (path == "/healthz") {
+      HandleHealthz(fd, OriginAllowed(cfg, origin) ? origin : "");
+    } else {
+      HandleGetRoot(fd, OriginAllowed(cfg, origin) ? origin : "");
+    }
+    return;
+  }
+
+  if (path.rfind("/v1/", 0) != 0) {
+    SendJson(fd, 404, "Not Found", JsonError("not found"), "");
+    return;
+  }
+
+  // The origin gate: a browser caller must come from an allowed origin; a
+  // token caller (curl, local tooling) may come from anywhere as long as it
+  // presents the token.
+  std::string cors;
+  bool allowed = false;
+  if (!origin.empty()) {
+    if (OriginAllowed(cfg, origin)) {
+      allowed = true;
+      cors = origin;
+    } else if (TokenOk(cfg, req)) {
+      allowed = true;  // not a browser origin: no CORS headers needed
+    }
+  } else if (TokenOk(cfg, req) || cfg.allow_no_origin) {
+    allowed = true;
+  }
+  if (!allowed) {
+    fprintf(stderr, "bootowser-control: 403 path=%s origin=%s\n",
+            path.c_str(), AuditField(origin).c_str());
+    SendJson(fd, 403, "Forbidden", JsonError("origin not allowed"), "");
+    return;
+  }
+
+  if (path == "/v1/exec") {
+    if (req.method != "POST") {
+      SendJson(fd, 405, "Method Not Allowed", JsonError("POST only"), cors);
+      return;
+    }
+    HandleExec(fd, cfg, req, cors);
+    return;
+  }
+  if (path == "/v1/root") {
+    if (req.method != "POST") {
+      SendJson(fd, 405, "Method Not Allowed", JsonError("POST only"), cors);
+      return;
+    }
+    HandleRoot(fd, cfg, req, cors);
+    return;
+  }
+  if (path == "/v1/commands") {
+    if (req.method != "GET") {
+      SendJson(fd, 405, "Method Not Allowed", JsonError("GET only"), cors);
+      return;
+    }
+    HandleCommands(fd, cfg, cors);
+    return;
+  }
+  SendJson(fd, 404, "Not Found", JsonError("not found"), cors);
+}
+
+bool GetEnvInt(const char* name, long long fallback, long long min,
+               long long max, long long* out, std::string* err) {
+  const char* raw = getenv(name);
+  if (!raw || !*raw) {
+    *out = fallback;
+    return true;
+  }
+  errno = 0;
+  char* end = nullptr;
+  long long value = strtoll(raw, &end, 10);
+  if (errno || end == raw || *end != '\0' || value < min || value > max) {
+    char msg[256];
+    snprintf(msg, sizeof(msg),
+             "%s must be an integer between %lld and %lld (got '%s')", name,
+             min, max, raw);
+    *err = msg;
+    return false;
+  }
+  *out = value;
+  return true;
+}
+
+bool GetEnvBool(const char* name, bool* out, std::string* err) {
+  const char* raw = getenv(name);
+  if (!raw || !*raw || strcmp(raw, "0") == 0) {
+    *out = false;
+    return true;
+  }
+  if (strcmp(raw, "1") == 0) {
+    *out = true;
+    return true;
+  }
+  *err = std::string(name) + " must be 0 or 1 (got '" + raw + "')";
+  return false;
+}
+
+}  // namespace
+
+bool LoadConfig(Config* out, std::string* err) {
+  long long value;
+
+  if (!GetEnvInt("PORT", out->port, 1, 65535, &value, err)) {
+    return false;
+  }
+  out->port = static_cast<int>(value);
+
+  if (const char* bind = getenv("BIND")) {
+    if (!*bind) {
+      *err = "BIND must not be empty";
+      return false;
+    }
+    out->bind_addr = bind;
+  }
+
+  if (const char* origins = getenv("ALLOWED_ORIGINS")) {
+    std::string list = origins;
+    size_t pos = 0;
+    while (pos <= list.size()) {
+      size_t comma = list.find(',', pos);
+      if (comma == std::string::npos) {
+        comma = list.size();
+      }
+      std::string item = list.substr(pos, comma - pos);
+      size_t begin = item.find_first_not_of(" \t");
+      size_t end = item.find_last_not_of(" \t");
+      if (begin != std::string::npos) {
+        out->allowed_origins.push_back(item.substr(begin, end - begin + 1));
+      }
+      pos = comma + 1;
+    }
+  }
+
+  if (const char* token = getenv("TOKEN")) {
+    out->token = token;
+  }
+  if (const char* dir = getenv("COMMANDS_DIR")) {
+    if (!*dir) {
+      *err = "COMMANDS_DIR must not be empty";
+      return false;
+    }
+    out->commands_dir = dir;
+  }
+
+  if (!GetEnvInt("DEFAULT_TIMEOUT_MS", out->default_timeout_ms, 1, 3600000,
+                  &value, err)) {
+    return false;
+  }
+  out->default_timeout_ms = value;
+
+  if (!GetEnvInt("MAX_TIMEOUT_MS", out->max_timeout_ms, 1, 3600000, &value,
+                 err)) {
+    return false;
+  }
+  out->max_timeout_ms = value;
+  out->default_timeout_ms = std::min(out->default_timeout_ms,
+                                     out->max_timeout_ms);
+
+  if (!GetEnvInt("MAX_OUTPUT_BYTES", static_cast<long long>(
+                                         out->max_output_bytes),
+                 1024, 64LL * 1024 * 1024, &value, err)) {
+    return false;
+  }
+  out->max_output_bytes = static_cast<size_t>(value);
+
+  if (!GetEnvInt("MAX_BODY_BYTES", static_cast<long long>(out->max_body_bytes),
+                 1024, 16LL * 1024 * 1024, &value, err)) {
+    return false;
+  }
+  out->max_body_bytes = static_cast<size_t>(value);
+
+  if (!GetEnvInt("MAX_CONCURRENT", out->max_concurrent, 1, 64, &value, err)) {
+    return false;
+  }
+  out->max_concurrent = static_cast<int>(value);
+
+  if (!GetEnvBool("ALLOW_NO_ORIGIN", &out->allow_no_origin, err)) {
+    return false;
+  }
+  if (!GetEnvBool("ALLOW_NONLOOPBACK", &out->allow_nonloopback, err)) {
+    return false;
+  }
+  return true;
+}
+
+}  // namespace bootowser
+
+int main(int argc, char** argv) {
+  using namespace bootowser;
+
+  if (argc >= 2) {
+    if (strcmp(argv[1], "-h") == 0 || strcmp(argv[1], "--help") == 0) {
+      printf("usage: bootowser-control [--help]\n"
+             "\n"
+             "Configuration comes from the environment; the systemd unit\n"
+             "supplies /etc/bootowser/control.conf via EnvironmentFile=.\n");
+      return 0;
+    }
+    fprintf(stderr, "bootowser-control: unknown argument: %s\n", argv[1]);
+    return 2;
+  }
+
+  std::string err;
+  if (!LoadConfig(&g_config, &err)) {
+    fprintf(stderr, "bootowser-control: %s\n", err.c_str());
+    return 2;
+  }
+
+  struct in_addr addr;
+  if (inet_pton(AF_INET, g_config.bind_addr.c_str(), &addr) != 1) {
+    fprintf(stderr,
+            "bootowser-control: BIND must be an IPv4 address (got '%s')\n",
+            g_config.bind_addr.c_str());
+    return 2;
+  }
+  bool loopback = (ntohl(addr.s_addr) >> 24) == 127;
+  if (!loopback && !g_config.allow_nonloopback) {
+    fprintf(stderr,
+            "bootowser-control: refusing to bind %s: the control sidecar "
+            "must stay on loopback (set ALLOW_NONLOOPBACK=1 to override, "
+            "and understand you are exposing a shell)\n",
+            g_config.bind_addr.c_str());
+    return 2;
+  }
+
+  signal(SIGPIPE, SIG_IGN);
+  struct sigaction sa;
+  memset(&sa, 0, sizeof(sa));
+  sa.sa_handler = OnTerm;
+  sigaction(SIGTERM, &sa, nullptr);
+  sigaction(SIGINT, &sa, nullptr);
+  memset(&sa, 0, sizeof(sa));
+  sa.sa_handler = OnSigChld;
+  sa.sa_flags = SA_RESTART | SA_NOCLDSTOP;
+  sigaction(SIGCHLD, &sa, nullptr);
+
+  int listen_fd = socket(AF_INET, SOCK_STREAM | SOCK_CLOEXEC, 0);
+  if (listen_fd < 0) {
+    fprintf(stderr, "bootowser-control: socket: %s\n", strerror(errno));
+    return 1;
+  }
+  int one = 1;
+  setsockopt(listen_fd, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+  struct sockaddr_in sa_bind;
+  memset(&sa_bind, 0, sizeof(sa_bind));
+  sa_bind.sin_family = AF_INET;
+  sa_bind.sin_port = htons(static_cast<uint16_t>(g_config.port));
+  sa_bind.sin_addr = addr;
+  if (bind(listen_fd, reinterpret_cast<struct sockaddr*>(&sa_bind),
+           sizeof(sa_bind)) != 0) {
+    fprintf(stderr, "bootowser-control: bind %s:%d: %s\n",
+            g_config.bind_addr.c_str(), g_config.port, strerror(errno));
+    return 1;
+  }
+  if (listen(listen_fd, 32) != 0) {
+    fprintf(stderr, "bootowser-control: listen: %s\n", strerror(errno));
+    return 1;
+  }
+
+  fprintf(stderr,
+          "bootowser-control: listening on %s:%d, %zu allowed origin(s), "
+          "token %s, commands in %s\n",
+          g_config.bind_addr.c_str(), g_config.port,
+          g_config.allowed_origins.size(),
+          g_config.token.empty() ? "unset" : "set",
+          g_config.commands_dir.c_str());
+
+  while (g_running) {
+    struct pollfd pfd = {listen_fd, POLLIN, 0};
+    int ready = poll(&pfd, 1, 1000);
+    if (ready < 0) {
+      if (errno == EINTR) {
+        continue;
+      }
+      fprintf(stderr, "bootowser-control: poll: %s\n", strerror(errno));
+      break;
+    }
+    if (ready == 0) {
+      continue;
+    }
+    int client = accept4(listen_fd, nullptr, nullptr, SOCK_CLOEXEC);
+    if (client < 0) {
+      if (errno == EINTR) {
+        continue;
+      }
+      fprintf(stderr, "bootowser-control: accept: %s\n", strerror(errno));
+      continue;
+    }
+
+    if (g_active.load(std::memory_order_relaxed) >= g_config.max_concurrent) {
+      WriteAll(client, HttpResponse(503, "Service Unavailable",
+                                    "application/json; charset=utf-8",
+                                    JsonError("too many concurrent "
+                                              "requests"),
+                                    ""));
+      close(client);
+      continue;
+    }
+
+    pid_t pid = fork();
+    if (pid == 0) {
+      // Connection child: handle exactly this request and exit. Reset the
+      // listener's signal dispositions first; RunArgv's waitpid must not
+      // race with OnSigChld here.
+      close(listen_fd);
+      struct sigaction dfl;
+      memset(&dfl, 0, sizeof(dfl));
+      dfl.sa_handler = SIG_DFL;
+      sigaction(SIGCHLD, &dfl, nullptr);
+      sigaction(SIGTERM, &dfl, nullptr);
+      sigaction(SIGINT, &dfl, nullptr);
+      HandleConnection(client, g_config);
+      close(client);
+      _exit(0);
+    }
+    if (pid > 0) {
+      g_active.fetch_add(1, std::memory_order_relaxed);
+      close(client);
+    } else {
+      fprintf(stderr, "bootowser-control: fork: %s\n", strerror(errno));
+      WriteAll(client, HttpResponse(500, "Internal Server Error",
+                                    "application/json; charset=utf-8",
+                                    JsonError("fork failed"), ""));
+      close(client);
+    }
+  }
+
+  close(listen_fd);
+  fprintf(stderr, "bootowser-control: shutting down\n");
+  return 0;
+}
