  *        to check if the close command key was pressed in aEvent.
  */
 function eventMatchesKey(aEvent, aKey) {
+  // [Bootowser] Callers look the key element up by id, and the Bootowser build
+  // compiles some of those keys out of browser-sets.inc.xhtml, so a null here
+  // is a normal result rather than a bug. There is no key to match against.
+  if (!aKey) {
+    return false;
+  }
+
   let keyPressed = (aKey.getAttribute("key") || "").toLowerCase();
   let keyModifiers = aKey.getAttribute("modifiers");
   let modifiers = ["Alt", "Control", "Meta", "Shift"];
diff --git a/browser/themes/shared/browser-shared.css b/browser/themes/shared/browser-shared.css
index 18d3d0ac79..c9ee9ca895 100644
--- a/browser/themes/shared/browser-shared.css
+++ b/browser/themes/shared/browser-shared.css
@@ -1862,3 +1862,41 @@ popupnotificationcontent {
 #bookmarksToolbarFolderMenu {
   --menuitem-icon: url("chrome://browser/skin/places/bookmarksToolbar.svg");
 }
+
+/* [Bootowser] Kiosk chrome.
+ *
+ * The kiosk has one job: show a page. Everything on the toolbox that is not
+ * that page -- the app menu, the menu bar, the bookmarks toolbar, the sidebar
+ * (which is where vertical tabs live), downloads, account sync, zoom -- is
+ * chrome nobody in front of the kiosk can use and that the operator cannot
+ * afford to have one keystroke away.
+ *
+ * These are hidden rather than deleted. The chrome JS looks most of these up by
+ * id and dereferences the result unconditionally, so removing the nodes turns
+ * a cosmetic change into a startup exception; display:none removes them from
+ * the layout and from the a11y tree, which is what "removed" means to anyone
+ * using the browser. The commands themselves are dealt with separately -- in
+ * browser-sets.inc.xhtml for the accelerators, and by policy for the rest.
+ *
+ * Gated on the bootowser attribute that navigator-toolbox.inc.xhtml only emits
+ * for MOZ_BOOTOWSER builds, so upstream builds are unaffected. */
+
+[bootowser] #toolbar-menubar,
+[bootowser] #unified-extensions-button,
+[bootowser] #PanelUI-button,
+[bootowser] #PersonalToolbar,
+[bootowser] #bookmarks-menu-button,
+[bootowser] #star-button-box,
+[bootowser] #sidebar-button,
+[bootowser] #sidebar-launcher-splitter,
+[bootowser] #sidebar-box,
+[bootowser] #sidebar-splitter,
+[bootowser] #vertical-tabs-newtab-button,
+[bootowser] #alltabs-button,
+[bootowser] #downloads-button,
+[bootowser] #fxa-toolbar-menu-button,
+[bootowser] #urlbar-zoom-button,
+[bootowser] #nav-bar-overflow-button,
+[bootowser] #panic-button {
+  display: none !important;
+}
diff --git a/dom/xul/MenuBarListener.cpp b/dom/xul/MenuBarListener.cpp
index 099f5411a7..b9be719e4a 100644
--- a/dom/xul/MenuBarListener.cpp
+++ b/dom/xul/MenuBarListener.cpp
@@ -204,6 +204,14 @@ nsresult MenuBarListener::KeyPress(Event* aKeyEvent) {
   }
 
 #ifndef XP_MACOSX
+// [Bootowser] F10 activates the menu bar. The kiosk hides the menu bar
+// (DisplayMenuBar policy plus the [bootowser] CSS), but "hidden" is a
+// paint-order property: the key still routed through this listener would
+// un-hide it and open the first menu. Enterprise policy binds a default,
+// not a listener, so the listener itself is gated. With the handler gone
+// F10 falls through to the accesskey path below, which has no menu bar to
+// activate.
+#ifndef MOZ_BOOTOWSER
   // Need to handle F10 specially on Non-Mac platform.
   if (nativeKeyEvent->mMessage == eKeyPress && keyCode == NS_VK_F10) {
     if ((keyEvent->GetModifiersForMenuAccessKey() & ~MODIFIER_CONTROL) == 0) {
@@ -236,6 +244,7 @@ nsresult MenuBarListener::KeyPress(Event* aKeyEvent) {
 
     return NS_OK;
   }
+#endif  // MOZ_BOOTOWSER
 #endif  // !XP_MACOSX
 
   RefPtr menuForKey = GetMenuForKeyEvent(*keyEvent);
