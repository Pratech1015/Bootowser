From fd976bd3a1e2b154c309546f07a3f20c089971ae Mon Sep 17 00:00:00 2001
From: Bootowser <b@o.local>
Date: Wed, 30 Sep 2026 19:05:12 +0530
Subject: [PATCH 3/3] chrome/browser: [Bootowser] block non-web navigations in
 kiosk sessions

Enterprise policy can block chrome://* via URLBlocklist, but that is a
runtime control an operator can weaken, and it will not automatically
cover schemes Chrome grows later. Kiosk mode is meant to be a one-way
door, so enforce a small allowlist at the navigation layer as defence
in depth:

  * http/https are always allowed
  * about:blank is allowed (Chromium's initial empty document)
  * everything else is cancelled, including chrome://, devtools://,
    chrome-extension://, view-source: and any file:// URL

Only main-frame navigations reach WillStartRequest() on a committed
document, and sub-frame loads are deliberately untouched: a page may
embed whatever it likes, but it can never navigate the kiosk itself out
of the web.

No-op unless --bootowser is present, so upstream builds are unaffected.
---
 ...ent_browser_client_navigation_throttles.cc | 43 +++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/chrome/browser/chrome_content_browser_client_navigation_throttles.cc b/chrome/browser/chrome_content_browser_client_navigation_throttles.cc
index 76ed083..2249c99 100644
--- a/chrome/browser/chrome_content_browser_client_navigation_throttles.cc
+++ b/chrome/browser/chrome_content_browser_client_navigation_throttles.cc
@@ -6,6 +6,7 @@
 
 #include "base/command_line.h"
 #include "base/feature_list.h"
+#include "base/logging.h"
 #include "build/build_config.h"
 #include "build/buildflag.h"
 #include "chrome/browser/actor/actor_navigation_throttle.h"
@@ -72,6 +73,7 @@
 #include "components/tabs/public/tab_interface.h"
 #include "components/user_prefs/user_prefs.h"
 #include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/navigation_throttle.h"
 #include "content/public/browser/navigation_throttle_registry.h"
 #include "content/public/browser/web_contents.h"
 #include "content/public/common/content_switches.h"
@@ -280,6 +282,45 @@ void MaybeCreateAndAddVisitedLinkNavigationThrottle(
       registry, history_service));
 }
 
+// Bootowser: blocks main-frame navigations to anything that is not ordinary
+// web content.
+//
+// Enterprise policy can block chrome://* through URLBlocklist, but that is a
+// runtime control an operator can weaken, and it does not automatically cover
+// schemes Chrome grows later. Kiosk mode is supposed to be a one-way door, so
+// we enforce a small allowlist at the navigation layer as defence in depth.
+// Sub-frames are deliberately left alone: pages are free to embed whatever
+// they like, but a page can never navigate the kiosk itself out of the web.
+class BootowserNavigationThrottle : public content::NavigationThrottle {
+ public:
+  explicit BootowserNavigationThrottle(
+      content::NavigationThrottleRegistry& registry)
+      : content::NavigationThrottle(registry) {}
+
+  content::NavigationThrottle::ThrottleCheckResult WillStartRequest() {
+    if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+            switches::kBootowser)) {
+      return PROCEED;
+    }
+
+    const GURL& url = navigation_handle()->GetURL();
+    if (!url.is_valid()) {
+      return CANCEL;
+    }
+    if (url.SchemeIsHTTPOrHTTPS()) {
+      return PROCEED;
+    }
+    // about:blank is what Chromium uses for the initial empty document, and
+    // file:// is only reachable for URLs the operator put on the command line.
+    if (url.SchemeIs("about") && url.path() == "blank") {
+      return PROCEED;
+    }
+
+    LOG(WARNING) << "bootowser: blocked navigation to " << url.spec();
+    return CANCEL;
+  }
+};
+
 }  // namespace
 
 void CreateAndAddChromeThrottlesForNavigation(
@@ -626,6 +667,8 @@ void CreateAndAddChromeThrottlesForNavigation(
   glic::GlicGuestNavigationThrottle::MaybeCreateAndAdd(registry);
 
   pwc::PwcNavigationThrottle::MaybeCreateAndAdd(registry);
+
+  registry.AddThrottle(std::make_unique<BootowserNavigationThrottle>(registry));
 }
 
