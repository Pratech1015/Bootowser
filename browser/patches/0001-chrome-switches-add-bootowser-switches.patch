From 4357950c22f2d2fceabdbff96aa00407c7f6ddb1 Mon Sep 17 00:00:00 2001
From: Bootowser <b@o.local>
Date: Wed, 30 Sep 2026 19:05:12 +0530
Subject: [PATCH 1/3] chrome/common: [Bootowser] add Bootowser command line
 switches

Adds a small, self-contained set of switches used by the Bootowser
stripped-Chromium build. Nothing in this change alters upstream
behaviour: every switch is inert unless it is actually passed on the
command line, and even then they are only consumed by the follow-up
change to ChromeMainDelegate::PreSandboxStartup().
---
 chrome/common/chrome_switches.h | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/chrome/common/chrome_switches.h b/chrome/common/chrome_switches.h
index a1e9d62..1ac54c2 100644
--- a/chrome/common/chrome_switches.h
+++ b/chrome/common/chrome_switches.h
@@ -449,6 +449,28 @@ inline constexpr char kKioskMode[] = "kiosk";
 // Enable automatically pressing the print button in print preview.
 inline constexpr char kKioskModePrinting[] = "kiosk-printing";
 
+// ---------------------------------------------------------------------------
+// Bootowser switches (https://github.com/Pratech1015/Bootowser)
+//
+// Bootowser is a stripped-down, boot-time kiosk browser. The switches below
+// are recognised only by a Bootowser build (see BUILDFLAG(BOOTOWSER) in
+// chrome/BUILD.gn) and are inert in upstream Chromium.
+// ---------------------------------------------------------------------------
+
+// Marks this process as part of a Bootowser session. When present, the browser
+// hard-enforces kiosk lockdown (see ChromeMainDelegate::PreSandboxStartup())
+// regardless of the other switches on the command line.
+inline constexpr char kBootowser[] = "bootowser";
+
+// Path to the Bootowser configuration file. Values read from this file are
+// applied to the command line with lower priority than explicit command line
+// switches.
+inline constexpr char kBootowserConfig[] = "bootowser-config";
+
+// Emits one structured line per boot phase on stderr. Used by the systemd
+// unit to order the Plymouth hand-off after the browser is ready.
+inline constexpr char kBootowserVerbose[] = "bootowser-verbose";
+
 // Makes Chrome default browser
 inline constexpr char kMakeDefaultBrowser[] = "make-default-browser";
 
