From 8580c5da41e52921ea5d11d6a9595360e36f0f1d Mon Sep 17 00:00:00 2001
From: Bootowser <b@o.local>
Date: Wed, 30 Sep 2026 19:05:12 +0530
Subject: [PATCH 2/3] chrome/app: [Bootowser] enforce kiosk lockdown at startup

Bootowser is a single-purpose browser started at boot and left
running. A kiosk that can be trivially escaped is worse than no kiosk
at all, so sanitise the command line once, in PreSandboxStartup(),
before any subsystem reads it.

When --bootowser is present we force the switches kiosk mode depends
on and strip the switches that would hand an attacker a debugging
port, untrusted code execution, or a relaxed security origin:

  * removed: remote-debugging-{port,pipe}, remote-allow-origins,
    remote-debugging-{socket-name,io-pipes}, disable-web-security,
    allow-file-access-from-files, load-extension,
    disable-extensions-except, renderer-cmdline, js-flags
  * forced: kiosk (promoting any --app URL so we never end up with an
    empty window), no-first-run, hide-crash-restore-bubble
  * removed: --app, --app-id, restore-last-session

Without --bootowser this is a no-op, so upstream builds are
bit-for-bit unaffected. Child processes inherit the sanitised command
line, so this only needs to run in the browser process.
---
 chrome/app/chrome_main_delegate.cc | 66 ++++++++++++++++++++++++++++++
 1 file changed, 66 insertions(+)

diff --git a/chrome/app/chrome_main_delegate.cc b/chrome/app/chrome_main_delegate.cc
index b8eeec7..f06ae81 100644
--- a/chrome/app/chrome_main_delegate.cc
+++ b/chrome/app/chrome_main_delegate.cc
@@ -22,6 +22,7 @@
 #include "base/i18n/rtl.h"
 #include "base/immediate_crash.h"
 #include "base/lazy_instance.h"
+#include "base/logging.h"
 #include "base/metrics/histogram_macros.h"
 #include "base/notreached.h"
 #include "base/path_service.h"
@@ -1419,7 +1420,72 @@ void ChromeMainDelegate::SetUpInstallerPreferences(
 }
 #endif  // BUILDFLAG(IS_MAC)
 
+namespace {
+
+// Bootowser: true if this process belongs to a locked-down kiosk session.
+//
+// Bootowser is a single-purpose browser that is started at boot and left
+// running. A kiosk that can be trivially escaped is worse than no kiosk at
+// all, so once --bootowser is present we both (a) force the switches that
+// kiosk mode depends on and (b) remove every switch that would let a local
+// attacker re-open a debugging port, load untrusted extensions, or re-enable
+// the subsystems that were stripped at build time.
+//
+// This runs on the browser process only; renderer/utility children inherit
+// the already-sanitised command line.
+void ApplyBootowserKioskLockdown() {
+  base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(switches::kBootowser)) {
+    return;
+  }
+
+  // Escapes. An attacker with local shell access must not be able to get a
+  // DevTools/CDP endpoint, run untrusted code, or relax the security origin.
+  constexpr const char* kStrippedSwitches[] = {
+      switches::kRemoteDebuggingPort,
+      switches::kRemoteDebuggingPipe,
+      switches::kRemoteAllowOrigins,
+      "remote-debugging-socket-name",
+      "remote-debugging-io-pipes",
+      switches::kDisableWebSecurity,
+      switches::kAllowFileAccessFromFiles,
+      "load-extension",
+      "disable-extensions-except",
+      "renderer-cmdline",
+      "js-flags",
+  };
+  for (const char* strip : kStrippedSwitches) {
+    command_line->RemoveSwitch(strip);
+  }
+
+  // Kiosk is not negotiable. If the launcher already supplied a --kiosk URL
+  // we leave it alone; otherwise promote any --app URL, since forcing kiosk
+  // without a URL would show an empty window.
+  if (!command_line->HasSwitch(switches::kKioskMode)) {
+    command_line->AppendSwitchNative(
+        switches::kKioskMode,
+        command_line->GetSwitchValueASCII(switches::kApp));
+  }
+  command_line->RemoveSwitch(switches::kApp);
+  command_line->RemoveSwitch(switches::kAppId);
+
+  // A boot-time session always starts from a known state, never from whatever
+  // the previous run happened to leave behind.
+  command_line->RemoveSwitch(switches::kRestoreLastSession);
+  command_line->AppendSwitch(switches::kNoFirstRun);
+  command_line->AppendSwitch(switches::kHideCrashRestoreBubble);
+
+  if (command_line->HasSwitch(switches::kBootowserVerbose)) {
+    LOG(WARNING) << "bootowser: kiosk lockdown applied, url="
+                 << command_line->GetSwitchValueASCII(switches::kKioskMode);
+  }
+}
+
+}  // namespace
+
 void ChromeMainDelegate::PreSandboxStartup() {
+  ApplyBootowserKioskLockdown();
+
   const base::CommandLine& command_line =
       *base::CommandLine::ForCurrentProcess();
   std::string process_type =
