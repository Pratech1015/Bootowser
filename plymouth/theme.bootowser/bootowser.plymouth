# theme.bootowser -- Plymouth boot splash for the Bootowser kiosk browser.
#
# Design notes
# ------------
# Bootowser replaces your boot splash with a browser, so this theme has one
# job: look good for a handful of seconds, stay out of the way, then hand the
# screen over cleanly. That means
#
#   * no logo animation (there is nowhere to hide the first paint anyway),
#   * no spinner that spins for minutes when a service is slow to start,
#   * a determinate bar that reflects systemd's real boot progress.
#
# Everything here uses only Image(), Image.Text(), Image.Scale(), Sprite(),
# Window.*, Plymouth.SetRefreshFunction and progress.*. The PNG assets are
# generated by tools/gen-plymouth-assets.py rather than committed as opaque
# binaries.
#
# KNOWN LIMITATION: passphrase prompts
# -----------------------------------
# If the root filesystem is encrypted, Plymouth asks the theme to render a
# passphrase field. Plymouth's raw key handler only gives us numeric keycodes
# and its scripting API has no verified way to turn those back into
# characters, so this theme renders the question text but cannot collect
# input. On a LUKS-encrypted root, keep your distribution's default Plymouth
# theme and enable Bootowser after unlock. See docs/security.md.

# ---------------------------------------------------------------------------
# Palette
# ---------------------------------------------------------------------------
BG_TOP_RED = 0.02;  BG_TOP_GREEN = 0.03;  BG_TOP_BLUE = 0.05;
BG_BOT_RED = 0.06;  BG_BOT_GREEN = 0.08;  BG_BOT_BLUE = 0.10;

FG_RED = 0.93;  FG_GREEN = 0.95;  FG_BLUE = 0.97;
DIM_RED = 0.45; DIM_GREEN = 0.48; DIM_BLUE = 0.52;
WARN_RED = 0.95; WARN_GREEN = 0.72; WARN_BLUE = 0.28;
ACCENT_RED = 0.16; ACCENT_GREEN = 0.86; ACCENT_BLUE = 0.62;

# ---------------------------------------------------------------------------
# Layout (computed once, from the real framebuffer size)
# ---------------------------------------------------------------------------
W = Window.GetWidth();
H = Window.GetHeight();

# Text is generated at 1080p and upscaled on bigger panels so the splash
# stays proportional from a 720p netbook to a 4K TV.
scale_factor = H / 1080;
if (scale_factor < 1) scale_factor = 1;

logo_size = H / 6;
if (logo_size > 260) logo_size = 260;
if (logo_size < 96)  logo_size = 96;

bar_w = W / 3;
if (bar_w > 560) bar_w = 560;
if (bar_w < 240) bar_w = 240;
bar_h = 8;

Window.SetBackgroundTopColor(BG_TOP_RED, BG_TOP_GREEN, BG_TOP_BLUE);
Window.SetBackgroundBottomColor(BG_BOT_RED, BG_BOT_GREEN, BG_BOT_BLUE);

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Swap a sprite's text for `text`, recoloured and kept horizontally centred.
# Returns nothing; callers that need the geometry use the cached images.
fun set_text(sprite, text, r, g, b, font) {
    img = Image.Text(text, r, g, b, 1, font, "center");
    img = img.Scale(img.GetWidth()  * scale_factor,
                    img.GetHeight() * scale_factor);
    sprite.SetImage(img);
    sprite.SetX((W - img.GetWidth()) / 2);
}

# ---------------------------------------------------------------------------
# Sprites
# ---------------------------------------------------------------------------
logo_img = Image("bootowser-logo.png");
logo_img = logo_img.Scale(logo_size, logo_size);
logo = Sprite(logo_img);
logo.SetX((W - logo_size) / 2);
logo.SetY(H / 2 - logo_size - H / 20);
logo.SetZ(10);

# The wordmark is generated text rather than an image so it stays crisp, and
# so the project name can be changed here without touching any binary asset.
wordmark = Sprite();
wordmark.SetZ(10);
set_text(wordmark, "B O O T O W S E R",
         ACCENT_RED, ACCENT_GREEN, ACCENT_BLUE, "Sans 20");
wordmark.SetY(H / 2 + H / 30);

# Boot messages (progress.prompt) -- "Starting Network", "Mounting /home", ...
message = Sprite();
message.SetZ(10);
set_text(message, "", FG_RED, FG_GREEN, FG_BLUE, "Sans 12");
message.SetY(H / 2 + H / 16);

# Progress bar: a dim track with a bright fill scaled to the boot progress.
bar_x = (W - bar_w) / 2;
bar_y = H / 2 + H / 9;

track_img = Image("bar-track.png");
track_img = track_img.Scale(bar_w, bar_h);
track = Sprite(track_img);
track.SetX(bar_x);
track.SetY(bar_y);
track.SetZ(10);

fill = Sprite();
fill.SetX(bar_x);
fill.SetY(bar_y);
fill.SetZ(11);
fill.SetOpacity(0);

percent = Sprite();
percent.SetZ(10);
set_text(percent, "0%", DIM_RED, DIM_GREEN, DIM_BLUE, "Sans 12");
percent.SetY(bar_y + bar_h + H / 45);

# Shown instead of the bar when Plymouth asks us a question we cannot answer.
warn = Sprite();
warn.SetZ(12);
set_text(warn, "", WARN_RED, WARN_GREEN, WARN_BLUE, "Sans 14");
warn.SetY(H / 2 - logo_size - H / 12);
warn.SetOpacity(0);

# ---------------------------------------------------------------------------
# Refresh
#
# Called up to 50x/second, so only touch the screen when something changed.
# ---------------------------------------------------------------------------
global.last_progress = -1;
global.last_prompt = "";
global.last_question = NULL;

fun refresh_callback() {
    # -- passphrase question ------------------------------------------------
    # Detect it early: a half-drawn bar next to an unanswerable prompt is the
    # worst possible boot experience, so swap the bar out for an explanation.
    question = progress.question;
    if (question != global.last_question) {
        global.last_question = question;
        if (question == NULL) {
            track.SetOpacity(1);
            fill.SetOpacity(0);
            percent.SetOpacity(1);
            warn.SetOpacity(0);
            message.SetOpacity(1);
        } else {
            track.SetOpacity(0);
            percent.SetOpacity(0);
            fill.SetOpacity(0);
            set_text(warn,
                     "This device needs to be unlocked before Bootowser can start",
                     WARN_RED, WARN_GREEN, WARN_BLUE, "Sans 14");
            warn.SetOpacity(1);
            set_text(message, question, FG_RED, FG_GREEN, FG_BLUE, "Sans 12");
            message.SetOpacity(1);
        }
    }

    if (question != NULL) {
        # Nothing further to draw while waiting on the operator.
        return;
    }

    # -- progress bar -------------------------------------------------------
    pct = progress.progress;
    if (pct != global.last_progress) {
        global.last_progress = pct;

        w = bar_w * pct / 100;
        if (w < 1) {
            fill.SetOpacity(0);
        } else {
            fill_img = Image("bar-fill.png");
            fill_img = fill_img.Scale(w, bar_h);
            fill.SetImage(fill_img);
            fill.SetX(bar_x);
            fill.SetY(bar_y);
            fill.SetOpacity(1);
        }

        set_text(percent, "" + pct + "%", DIM_RED, DIM_GREEN, DIM_BLUE, "Sans 12");
    }

    # -- boot message -------------------------------------------------------
    prompt = progress.prompt;
    if (prompt == NULL) prompt = "";
    if (prompt != global.last_prompt) {
        global.last_prompt = prompt;
        set_text(message, prompt, FG_RED, FG_GREEN, FG_BLUE, "Sans 12");
    }
}
Plymouth.SetRefreshFunction(refresh_callback);