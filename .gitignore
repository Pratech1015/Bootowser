# Chromium build trees and output.
# fetch.sh checks out into /src, build.sh writes to /out.
/src/
/out/
*.ninja
*.ninja_log
*.ninja_deps

# depot_tools defaults to ~/depot_tools, but --depot-tools or an overridden
# HOME can put it inside the tree. Chromium checkouts are ~40 GB; never commit
# one by accident.
/depot_tools/
/browser/depot_tools/
/src/

# Editor / OS noise
*.swp
*~
.DS_Store
.idea/
.vscode/

# Build logs and scratch
*.log
/tmp/