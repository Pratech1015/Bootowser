# Firefox build trees and objdir output.
#
# fetch.sh checks out wherever --dest points (default ~/firefox-src, outside
# the repo), but an operator can still put the tree inside the checkout.
# firefox/mozconfig-bootowser sets MOZ_OBJDIR to ../obj-bootowser.
#
# A Firefox checkout is ~5 GB and the objdir reaches ~20 GB after a build.
# Never commit one by accident.
/firefox/src/
/firefox/firefox-src/
/firefox/obj-bootowser/
/firefox/obj-*/
/src/
/out/

# Editor / OS noise
*.swp
*~
.DS_Store
.idea/
.vscode/

# Build logs and scratch
*.log

# The packaged browser and its tarball, sitting in the repo root after a
# local ./mach package. The extracted tree is several hundred MB and the
# tarball is the same bytes you can pull from the GitHub release.
/bootowser/
/bootowser-*.tar.xz

# Kiosk test rig: config, profile and the local test page used for
# manual runs of the launcher.
/bs-test.conf
/bs-test/
/bs-tabs-test/
/tmp/