#!/bin/sh
# Post-installation for bootowser.
set -e

case "$1" in
  configure)
    # Unprivileged kiosk user. It only ever needs to talk to X, a GPU and the
    # journal; everything else is denied by the unit's sandboxing.
    if ! getent passwd bootowser >/dev/null; then
      adduser --system --group --home /var/lib/bootowser \
              --no-create-home --disabled-password \
              --gecos "Bootowser kiosk browser" bootowser \
        >/dev/null 2>&1 || true
    fi
    if getent group video >/dev/null; then
      adduser bootowser video >/dev/null 2>&1 || true
    fi

    install -d -m 0700 -o bootowser -g bootowser /var/lib/bootowser/profile

    # The control sidecar escalates only through this fragment; a syntax
    # error here would be noticed exactly when someone needs a root hook.
    # visudo -c also pins ownership/mode expectations when run as root.
    if [ -e /etc/sudoers.d/bootowser ] && command -v visudo >/dev/null 2>&1; then
      if ! visudo -cf /etc/sudoers.d/bootowser >/dev/null 2>&1; then
        echo "bootowser: WARNING: /etc/sudoers.d/bootowser fails sudoers validation;" >&2
        echo "             root hooks will not work until it is fixed." >&2
      fi
    fi

    if [ -z "$2" ] && [ -e /etc/bootowser/bootowser.conf ]; then
      # A fresh install ships a placeholder URL, and the units are enabled
      # at boot now, so the first boot would show the placeholder. Make the
      # next step obvious.
      if grep -q '^START_URL="https://start.example.com"$' /etc/bootowser/bootowser.conf; then
        cat >&2 <<'MSG'

bootowser: set your start URL before the first boot:
    $EDITOR /etc/bootowser/bootowser.conf
    systemctl start bootowser        # or just reboot

MSG
      fi
      if [ -x /usr/lib/bootowser/bootowser-control ] \
         && grep -q '^ALLOWED_ORIGINS="https://start.example.com"' \
              /etc/bootowser/control.conf 2>/dev/null; then
        cat >&2 <<'MSG'
bootowser: to let that page call the command API, allow its origin:
    $EDITOR /etc/bootowser/control.conf   # ALLOWED_ORIGINS must match START_URL

MSG
      fi
    fi
    ;;

  abort-upgrade|abort-remove|abort-deconfigure)
    ;;
esac

#DEBHELPER#

exit 0
